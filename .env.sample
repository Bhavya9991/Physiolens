# Copy this file to .env and paste your keys locally.
# Leave secrets empty. Never commit a real key.
SERPAPI_API_KEY=

# Free Gemini key from https://aistudio.google.com/apikey
# The variable name stays OPENAI_API_KEY because the client library reads that name.
OPENAI_API_KEY=
OPENAI_MODEL=gemini-3.8-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# gemini or groq. Every agent calls ask(); this chooses the endpoint.
# Leave this as gemini until GROQ_API_KEY is filled in.
LLM_PROVIDER=gemini

# Free key from https://console.groq.com/keys
# openai/gpt-oss-120b is on the free plan and supports strict structured output.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
